{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-intake": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/bin/launch-curator-mcp.py",
        "--database-bindings",
        "~/.config/curatormd-v2/database-bindings.json",
        "--allow-write",
        "--allow-purge-retry"
      ]
    }
  }
}
